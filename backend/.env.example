PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/small-crm
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Demo account exposed by the "Try the demo" button
DEMO_EMAIL=demo@northlight.co
DEMO_PASSWORD=demo1234

# Reminder emails (leave blank to log to console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Northlight CRM <no-reply@northlight.co>"
ENABLE_REMINDER_CRON=true
